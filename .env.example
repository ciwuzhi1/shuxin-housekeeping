# 舒心家政服务平台 · 环境变量示例
# 用法：复制本文件为 .env（.env 已被 .gitignore 排除，不会进入仓库），按需修改。
# 后端通过 python-dotenv 加载；未设置的变量使用下方「默认值」。

# ========== 服务端 ==========
# 后端监听端口
PORT=3001

# ========== 数据库（MySQL 8.0）==========
DB_HOST=127.0.0.1
DB_PORT=3306
# 开发默认 root/root，生产环境必须更换
DB_USER=root
DB_PASSWORD=root
# 业务库名（pytest 会自动创建/销毁独立的 housekeeping_test 测试库）
DB_NAME=housekeeping

# ========== 认证 ==========
# JWT 签名密钥：开发可用默认值，生产必须更换为强随机串（如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-strong-random-secret
# Token 有效期（秒），默认 24h
JWT_EXPIRES=86400
# 密码哈希盐（SHA-256 + 固定盐，演示级方案）：生产必须更换
PASSWORD_SALT=change-me-to-a-strong-random-salt

# ========== 分页 ==========
PAGE_SIZE=20
# 单页上限，接口会自动钳制
MAX_PAGE_SIZE=100

# ========== 限流 ==========
# 每 IP 每分钟最大请求数
RATE_LIMIT_MAX=200

# ========== 跨域 ==========
# 允许的前端来源；生产改为实际域名，如 https://example.com
CORS_ORIGIN=http://localhost:3000
